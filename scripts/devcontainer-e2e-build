#!/usr/bin/env bash
# =============================================================================
# devcontainer-e2e-build
#
# In-container entrypoint that delegates the full Wire stack build (cdt →
# sysio → libraries-ts → tools-ts → ethereum → solana) to
# scripts/wire-local-setup.bash.
#
# Must be run from inside the devcontainer — guarded by IN_DEVCONTAINER /
# WIRE_WORKSPACE / CC / CXX presence checks.
# =============================================================================

set -euo pipefail

# --- devcontainer guard ------------------------------------------------------

if [[ -z "${IN_DEVCONTAINER:-}" ]] \
  || [[ -z "${WIRE_WORKSPACE:-}" ]] \
  || [[ -z "${CC:-}" ]] \
  || [[ -z "${CXX:-}" ]]; then
  echo "This script is meant to be run inside the devcontainer. Please run './scripts/devcontainer-setup' first." >&2
  exit 255
fi

# --- path resolution ---------------------------------------------------------

export WIRE_PREFIX="${HOME}/.local"

wireDevContainerBinDir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
wireDevContainerRoot="$(dirname "${wireDevContainerBinDir}")"
wireRepoRoot="$(cd "$(dirname "${wireDevContainerRoot}")" && pwd)"
wireOPPRoot="${wireRepoRoot}/wire-sysio/build/opp"

export wireDevContainerBinDir wireDevContainerRoot wireRepoRoot wireOPPRoot

# Default TASK_CPUS to 4 if unset; cpuCount = ceil(TASK_CPUS / 2). Bash
# integer math truncates, so `(N + 1) / 2` is the standard ceiling idiom
# for positive integers.
: "${TASK_CPUS:=4}"
export TASK_CPUS
cpuCount=$(( (TASK_CPUS + 1) / 2 ))
export cpuCount

# --- helpers -----------------------------------------------------------------

die() {
  echo "$1" >&2
  exit 255
}

run() {
  "$@" || die "An error occurred while executing: $*"
}

# --- delegate to wire-local-setup.bash --------------------------------------

wireSetupScript="${wireDevContainerBinDir}/wire-local-setup.bash"
if [[ ! -e "${wireSetupScript}" ]]; then
  die "${wireSetupScript} is missing"
fi

echo "Starting: ${wireSetupScript} --skip-apt --skip-clone --ignore-docker ${wireRepoRoot}"
run "${wireSetupScript}" \
  --skip-apt \
  --skip-clone \
  --ignore-docker \
  "${wireRepoRoot}"
